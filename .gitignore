# Dependencies
**/node_modules/

# Build output
**/dist/
**/*.tsbuildinfo

# Tutorial 08: the VM builds no code, the Dockerfiles copy these prebuilt folders
!backend/dist/
!frontend/dist/

# Local database generated by TypeORM (backend)
**/*.sqlite

# Logs
**/*.log

# Environment files
**/.env
# Holds only the public API URL, which Vite bakes into dist anyway — no secrets
!frontend/.env

# OS files
.DS_Store
Thumbs.db
